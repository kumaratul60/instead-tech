{
  "name": "tax-form-annotation-engine",
  "version": "1.0.0",
  "description": "Comprehensive specification and React/TypeScript reference engine for annotating U.S. Tax Forms.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "validate": "npm run typecheck && npm test"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "tax",
    "forms",
    "irs",
    "annotation",
    "react",
    "pdf",
    "overlay"
  ],
  "author": "Google DeepMind Antigravity",
  "license": "MIT"
}
